# PaperPilot-Lite environment overrides.
# Copy this file to .env only when you actually need local overrides.
# Do not commit .env.

# General
PAPERPILOT_PROJECT_NAME=PaperPilot-Lite

# Paths
PAPERPILOT_RAW_DIR=data/raw
PAPERPILOT_PROCESSED_DIR=data/processed
PAPERPILOT_INDEX_DIR=data/index
PAPERPILOT_EVAL_DIR=data/eval

# Chunking
PAPERPILOT_CHUNK_SIZE=500
PAPERPILOT_OVERLAP=100

# Retrieval
PAPERPILOT_TOP_K=5
PAPERPILOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PAPERPILOT_SIMILARITY=cosine
PAPERPILOT_DEVICE=cpu
PAPERPILOT_BATCH_SIZE=32
PAPERPILOT_NORMALIZE_EMBEDDINGS=true

# Prompt
PAPERPILOT_TEMPLATE_NAME=grounded
PAPERPILOT_MAX_CONTEXT_CHARS=4000
PAPERPILOT_MAX_CHUNK_CHARS=1200

# Logging
PAPERPILOT_LOG_LEVEL=INFO
PAPERPILOT_LOG_FILE=logs/app.log

# Goal 1 / R2 real LLM access.
# Safe default: mock. Use openai-compatible to enable a real provider.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_THINKING_ENABLED=false
LLM_TIMEOUT=60
